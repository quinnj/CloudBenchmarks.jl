# Required
CLOUDBENCH_GCP_BUCKET=jq-reseau-http-test

# Pick one credential flow
# CLOUDBENCH_GCP_ACCESS_TOKEN=ya29...
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json

# Optional
# CLOUDBENCH_GCP_QUOTA_PROJECT=my-gcp-project
# CLOUDBENCH_MACHINE_SPECS=gcp-c3-highbw
# CLOUDBENCH_PROFILE=full
# CLOUDBENCH_TLS=reseau
# CLOUDBENCH_NTHREADS=16
# CLOUDBENCH_NWORKERS=0
# CLOUDBENCH_SEMAPHORE_LIMITS=16,32,64
# CLOUDBENCH_OPERATIONS=put,get,prefetchdownloadstream
# CLOUDBENCH_SIZES=262144,1048576,8388608,67108864,268435456
# CLOUDBENCH_NTIMES=3
# CLOUDBENCH_OUTPUT_DIR=vm/results
# CLOUDBENCH_DRY_RUN=0

# Branch pin overrides for setup-gcp-vm.sh
# CLOUDBENCHMARKS_BRANCH=jq-reseau-http
# CLOUDBASE_BRANCH=jq-reseau-http
# CLOUDSTORE_BRANCH=jq-reseau-http
# RESEAU_BRANCH=main

# Optional local sibling checkout overrides for the vm runner.
# Relative paths are resolved from vm/Project.toml.
# CLOUDBASE_PATH=../../CloudBase
# CLOUDSTORE_PATH=../../CloudStore
# RESEAU_PATH=../../Reseau
