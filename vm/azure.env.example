# Preferred
# CLOUDBENCH_PROVIDER=azure
# CLOUDBENCH_AZURE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net"

# Or SAS token auth
# CLOUDBENCH_AZURE_ACCOUNT=myaccount
# AZURE_STORAGE_SAS_TOKEN="sp=...&st=...&se=...&spr=https&sv=...&sr=c&sig=..."

# Optional existing container
# CLOUDBENCH_AZURE_CONTAINER=existing-container-name

# Optional benchmark config
# CLOUDBENCH_KEEP_STORE=0
# CLOUDBENCH_SMOKE_SIZE=1048576
# CLOUDBENCH_SMOKE_PARTS=4
# CLOUDBENCH_MACHINE_SPECS=azure-live-smoke
# CLOUDBENCH_PROFILE=smoke
# CLOUDBENCH_TLS=reseau
# CLOUDBENCH_NTHREADS=24
# CLOUDBENCH_NWORKERS=0
# CLOUDBENCH_SEMAPHORE_LIMITS=16
# CLOUDBENCH_OPERATIONS=put,get,prefetchdownloadstream
# CLOUDBENCH_SIZES=262144,1048576,8388608,67108864,268435456
# CLOUDBENCH_NTIMES=1
# CLOUDBENCH_OUTPUT_DIR=vm/results
# CLOUDBENCH_DRY_RUN=0

# Optional local sibling checkout overrides for the vm runner.
# Relative paths are resolved from vm/Project.toml.
# CLOUDBASE_PATH=../../CloudBase
# CLOUDSTORE_PATH=../../CloudStore
# HTTP_PATH=../../HTTP
# RESEAU_PATH=../../Reseau
